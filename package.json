  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1",
    "@supabase/supabase-js": "^2.112.3",
    "@types/pg": "^8.21.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
